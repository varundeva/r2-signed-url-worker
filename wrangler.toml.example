#:schema https://pages.cloudflare.com/resources/wrangler.schema.json
name = "r2-signed-url-worker"
main = "src/index.js"
compatibility_date = "2024-11-01"

# -----------------------------------------------------------------
# DEVELOPMENT ENVIRONMENT
# Deployment command: npx wrangler deploy --env dev
# -----------------------------------------------------------------
[env.dev]
name = "r2-signed-url-worker-dev"
account_id = "PASTE_YOUR_DEV_ACCOUNT_ID_HERE"

[[env.dev.r2_buckets]]
binding = "R2_BUCKET"
bucket_name = "dev-bucket-name" # Use a separate bucket for testing

[env.dev.vars]
ENVIRONMENT = "development"
SIGNING_SECRET = "dev-secret-keep-it-simple"

# -----------------------------------------------------------------
# PRODUCTION ENVIRONMENT
# Deployment command: npx wrangler deploy --env prod
# -----------------------------------------------------------------
[env.prod]
name = "r2-signed-url-worker"
account_id = "PASTE_YOUR_PROD_ACCOUNT_ID_HERE"

[[env.prod.r2_buckets]]
binding = "R2_BUCKET"
bucket_name = "prod-bucket-name" # Your actual production bucket

[env.prod.vars]
ENVIRONMENT = "production"
# For production, it's better to use: npx wrangler secret put SIGNING_SECRET --env prod
# But you can define it here if you prefer:
SIGNING_SECRET = "your-long-production-only-secret-key"